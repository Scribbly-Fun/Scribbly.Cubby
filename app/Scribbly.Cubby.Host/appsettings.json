{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Scribbly.Cubby": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cubby": {
    "Store": "Sharded",
    "Capacity": 2000,
    "Cleanup": {
      "Strategy": "Duration",
      "Delay": "00:01:00"
    }
  }
}
